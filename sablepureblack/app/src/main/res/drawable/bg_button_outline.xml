<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sable_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sable_surface" />
            <corners android:radius="16dp" />
            <stroke
